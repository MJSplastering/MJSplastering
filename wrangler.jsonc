// Cloudflare Worker: MJS static site + enquiry API.
// Static files are served straight from the repository root; only /api/* runs the Worker script.
{
  "name": "mjsplastering",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-11",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "workers_dev": true,
  "preview_urls": true,

  // ENQUIRY_TO / ENQUIRY_FROM (plain variables) and RESEND_API_KEY / TURNSTILE_SECRET_KEY (secrets)
  // are set in the Cloudflare dashboard. keep_vars stops deploys from removing dashboard variables.
  "keep_vars": true,

  "observability": { "enabled": true }
}
